# CasperProver runtime configuration
#
# This file is the canonical template. Copy to `.env` and fill in values.
# CI never reads .env — only the API server + local dev do.

# --- Casper Network -----------------------------------------------------
# Public RPC endpoint. Testnet default. For a private node, point to your
# node's `/rpc` route.
CASPER_NODE_URL=https://node.testnet.casper.network
CASPER_CHAIN=casper-test

# Path to the deployer's Ed25519 secret key (PEM). Never check this file in.
# Used ONLY by `scripts/deploy-*.sh` — the API server does not read the key.
DEPLOYER_KEY_PATH=./keys/secret_key.pem

# --- API server ---------------------------------------------------------
API_PORT=10000

# Static API key. Required for POST endpoints when CP_STRICT=1.
# Rotate by editing this file — the server re-reads on restart.
API_KEY=

# When set to "1", the API refuses any anchored request it cannot forward
# to Casper (node unreachable, missing contract hash, invalid signature).
# Default is "0" for local dev — always set to "1" in production.
CP_STRICT=0

# --- Deployed contract hashes ------------------------------------------
# Populate from `deploy-out/onchain.json` after each deploy. When left
# empty the API falls back to the hashes baked into `engine/internal/api/server.go`
# (see the `envOrDefault` calls) — that fallback is only safe for the
# testnet deployment recorded in `frontend/public/onchain.json`.
CONTRACT_PROOF_REGISTRY=
CONTRACT_VERIFIER_GATE=
CONTRACT_DEFI_MOCK=
CONTRACT_STAKE_SLASHING=

# --- Undeployed contract hashes ----------------------------------------
# These three contracts compile but exceed Casper's 65 KB WASM ceiling and
# have NOT been deployed. The env vars are declared so that CI, judges and
# integrators know they exist and can be populated once the size fix lands.
# Server code paths that need them fail loudly (`env var not set`) rather
# than silently returning zero — see `engine/internal/submitter/casper.go`.
CONTRACT_MODEL_REGISTRY=
CONTRACT_PROOF_AGGREGATION=
CONTRACT_PROOF_OF_INFERENCE=

# --- Storage -----------------------------------------------------------
# Optional: Postgres URL for the receipts store. When empty the API uses
# an in-memory store — fine for local dev, wrong for production.
DATABASE_URL=

# --- MIGRATION NOTE ----------------------------------------------------
# Older builds referenced env vars like `PROOF_REGISTRY_HASH`,
# `VERIFIER_GATE_HASH`, `DEFI_MOCK_HASH`, `STAKE_SLASHING_HASH`. Those
# aliases were dropped in favour of the `CONTRACT_<NAME>` convention above
# so a single grep tells you every on-chain address the server touches.
# If you're upgrading from an older .env, rename them 1:1 — semantics
# are identical.
# ------------------------------------------------------------------
# LLM adapter — multi-provider parallel fan-out (Gate 3)
# ------------------------------------------------------------------
# Backend-only. Never exposed to the frontend. Never committed.
# Each provider may supply one or more keys (comma-separated within a
# single variable OR via numbered aliases like GROQ_API_KEY / GROQ2_API_KEY).
# The KeyRing round-robins across all keys of a provider and cools down
# a key that hits a 429/5xx.

# Tier: fast (parallel fan-out)
GROQ_API_KEY=
GROQ2_API_KEY=
NVIDIA_API_KEY=

# Tier: fast aggregator
OPENROUTER_API_KEY=
OPENROUTER2_API_KEY=

# Tier: reliability
ZAI_API_KEY=
ZAI2_API_KEY=
GEMINI_API_KEY=

# Fixture fallback (deterministic; used when every real provider fails).
# Set to 1 to force fixture mode (dev/CI without keys).
LLM_FIXTURE_MODE=0
# Per-provider request timeout (ms); default 3000.
LLM_PROVIDER_TIMEOUT_MS=3000
# Total budget across all tiers (ms); default 8000.
LLM_TOTAL_BUDGET_MS=8000

